{
    "name": "ai-worker-desktop",
    "version": "0.1.2",
    "description": "Open-source desktop AI workspace with private local chat and model management.",
    "main": "./out/main/index.js",
    "author": "AI-Worker Team <team@aiworker.app>",
    "homepage": "https://github.com/meharajM/ai-worker-desktop",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meharajM/ai-worker-desktop.git"
    },
    "bugs": {
        "url": "https://github.com/meharajM/ai-worker-desktop/issues"
    },
    "keywords": [
        "ai-worker",
        "ai-assistant",
        "desktop-ai",
        "electron",
        "model-context-protocol",
        "mcp",
        "llm",
        "agent-workspace",
        "voice-interface",
        "prompt-engineering",
        "context-engineering",
        "harness-engineering",
        "ai-agents",
        "electron-app",
        "desktop-agent",
        "local-llm",
        "on-device-ai",
        "local-first",
        "browser-automation",
        "playwright",
        "whatsapp-integration",
        "openai",
        "ollama"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "tauri:dev": "tauri dev",
        "tauri:proof": "tauri dev --features proof --config src-tauri/tauri.proof.conf.json",
        "tauri:build": "tauri build",
        "tauri:prepare:runtime": "bash scripts/prepare-llama-runtime-macos-arm64.sh",
        "tauri:build:mac:arm64": "npm run tauri:prepare:runtime && tauri build",
        "web:typecheck": "tsc --noEmit --project tsconfig.web.json",
        "web:build": "vite build --config vite.tauri.config.ts",
        "web:proof-build": "vite build --config vite.proof.config.ts",
        "test:rust:chat": "cargo test --manifest-path src-tauri/Cargo.toml chat::tests",
        "test:rust:proof": "cargo test --manifest-path src-tauri/Cargo.toml --features proof native_proof::tests"
    },
    "dependencies": {
        "@assistant-ui/react": "^0.15.27",
        "@electron-toolkit/preload": "^3.0.0",
        "@electron-toolkit/utils": "^3.0.0",
        "@langchain/core": "1.2.17",
        "@langchain/langgraph": "1.4.21",
        "@langchain/openai": "1.6.2",
        "@mlc-ai/web-llm": "^0.2.80",
        "@modelcontextprotocol/sdk": "^1.0.1",
        "@modelcontextprotocol/server-memory": "^2025.11.25",
        "@playwright/mcp": "^0.0.53",
        "@radix-ui/react-dialog": "^1.1.15",
        "@tauri-apps/api": "2.12.2",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@whiskeysockets/baileys": "^6.7.21",
        "better-sqlite3": "^12.6.2",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "electron-store": "10.0.0",
        "firebase": "^12.8.0",
        "fix-path": "^5.0.0",
        "formik": "^2.4.9",
        "framer-motion": "^12.26.2",
        "lucide-react": "^0.468.0",
        "playwright-core": "^1.58.2",
        "playwright-extra": "^4.3.6",
        "puppeteer-extra-plugin-stealth": "^2.11.2",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.0",
        "remark-gfm": "^4.0.1",
        "sharp": "^0.34.5",
        "tailwind-merge": "^3.4.0",
        "tree-kill": "^1.2.2",
        "vosk-browser": "^0.0.8",
        "ws": "^8.20.0",
        "yup": "^1.7.1",
        "zod": "4.2.1",
        "zustand": "^5.0.9"
    },
    "devDependencies": {
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@electron/rebuild": "^3.7.1",
        "@playwright/test": "^1.50.1",
        "@tauri-apps/cli": "2.12.1",
        "@types/better-sqlite3": "^7.6.9",
        "@types/node": "^22.13.1",
        "@types/qrcode": "^1.5.5",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.18",
        "electron": "^40.0.0",
        "electron-builder": "26.4.0",
        "electron-vite": "^5.0.0",
        "eslint": "^9.21.0",
        "eslint-plugin-react": "^7.37.4",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "postcss": "^8.4.35",
        "semver": "^7.7.4",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1"
    },
    "build": {
        "appId": "com.aiworker.app",
        "productName": "AI-Worker",
        "directories": {
            "output": "dist"
        },
        "files": [
            "out/**/*",
            "!out/**/*.map"
        ],
        "asarUnpack": [
            "node_modules/@whiskeysockets/baileys/**/*",
            "node_modules/@whiskeysockets/libsignal-node/**/*",
            "node_modules/libsignal/**/*"
        ],
        "mac": {
            "target": [
                "zip"
            ],
            "mergeASARs": false,
            "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/{@img/**,better-sqlite3/**,fsevents/**}",
            "category": "public.app-category.productivity",
            "icon": "build/icon.png"
        },
        "extraResources": [
          {
            "from": "scripts",
            "to": "scripts",
            "filter": [
              "setup-dependencies.sh",
              "setup-dependencies.ps1"
            ]
          }
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "build/icon.png",
            "artifactName": "${productName}-Setup-${version}.${ext}",
            "publish": {
                "provider": "generic",
                "url": "https://downloads.ai-worker.tech"
            }
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility",
            "maintainer": "AI-Worker Team <team@aiworker.app>",
            "publish": {
                "provider": "generic",
                "url": "https://downloads.ai-worker.tech"
            }
        }
    }
}
