{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Worker",
  "version": "0.1.2",
  "identifier": "com.aiworker.app.tauri",
  "bundle": {
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "build": {
    "frontendDist": "static",
    "beforeBuildCommand": "npm run web:build",
    "beforeDevCommand": "npm run web:build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    },
    "windows": [
      {
        "label": "main",
        "title": "AI-Worker",
        "width": 1100,
        "height": 760
      }
    ]
  }
}
