{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Worker",
  "version": "0.1.2",
  "identifier": "com.aiworker.app.tauri",
  "bundle": {
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["main"]
    },
    "windows": [
      {
        "label": "main",
        "title": "AI-Worker",
        "width": 1100,
        "height": 760
      }
    ]
  }
}
