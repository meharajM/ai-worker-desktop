{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-Worker",
  "version": "0.1.2",
  "identifier": "com.aiworker.app.tauri",
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../scripts/ai-worker-readonly-mcp.mjs": "mcp/scripts/ai-worker-readonly-mcp.mjs",
      "../node_modules/@modelcontextprotocol/sdk/": "mcp/node_modules/@modelcontextprotocol/sdk/",
      "../node_modules/zod/": "mcp/node_modules/zod/",
      "../node_modules/zod-to-json-schema/": "mcp/node_modules/zod-to-json-schema/",
      "../node_modules/ajv/": "mcp/node_modules/ajv/",
      "../node_modules/ajv-formats/": "mcp/node_modules/ajv-formats/",
      "../node_modules/fast-deep-equal/": "mcp/node_modules/fast-deep-equal/",
      "../node_modules/fast-uri/": "mcp/node_modules/fast-uri/",
      "../node_modules/json-schema-traverse/": "mcp/node_modules/json-schema-traverse/",
      "../node_modules/json-schema-typed/": "mcp/node_modules/json-schema-typed/",
      "../node_modules/require-from-string/": "mcp/node_modules/require-from-string/"
    }
  },
  "build": {
    "frontendDist": "static",
    "beforeBuildCommand": "npm run web:build",
    "beforeDevCommand": "npm run web:build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main", "write-approval", "task-activity"]
    },
    "windows": [
      {
        "label": "main",
        "title": "AI-Worker",
        "width": 1100,
        "height": 760
      }
    ]
  }
}
