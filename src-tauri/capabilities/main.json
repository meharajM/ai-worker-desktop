{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with status, session, preferences, and explicit model setup commands",
  "windows": ["main"],
  "permissions": [
    "allow-status",
    "allow-bridge-open-session",
    "allow-bridge-get-status",
    "allow-bridge-get-preferences",
    "allow-bridge-update-preferences",
    "allow-model-catalog",
    "allow-model-import",
    "allow-model-cancel-import"
  ]
}
